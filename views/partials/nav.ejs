<nav class="site-nav">
  <div class="nav-inner">

    <a class="brand" href="/">
      Blogify
    </a>

    <div class="nav-left">
      <a class="nav-link active" href="/">
        Home
      </a>

      <% if (locals.user) { %>
        <a class="nav-link nav-write" href="/blog/add-new">
          Write a post
        </a>
      <% } %>
    </div>

    <form action="/" method="GET" class="search-form" role="search">
      <input
        class="search-input"
        type="search"
        name="q"
        value="<%= locals.search || "" %>"
        placeholder="Search posts"
        aria-label="Search posts"
      >
    </form>

    <div class="nav-right">

      <% if (locals.user) { %>

        <div class="user-menu">
          <div class="user-avatar">
            <%= user.fullName
              ? user.fullName
                  .split(" ")
                  .map(name => name[0])
                  .join("")
                  .slice(0, 2)
                  .toUpperCase()
              : "U"
            %>
          </div>

          <span class="user-name">
            <%= user.fullName %>
          </span>

          <a class="signout-button" href="/user/signout">
            Sign out
          </a>
        </div>

      <% } else { %>

        <a class="nav-link" href="/user/signin">
          Sign in
        </a>

        <a class="create-account-button" href="/user/signup">
          Create account
        </a>

      <% } %>

    </div>
  </div>
</nav>

<% if (locals.error) { %>
  <div class="error-wrapper">
    <div class="error-message">
      <%= error %>
    </div>
  </div>
<% } %>