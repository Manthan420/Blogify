<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head.ejs") %>
  <title>Sign in - Blogify</title>
</head>

<body>
  <%- include("partials/nav") %>

  <main class="auth-page">

    <section class="auth-card">

      <h1>Sign in</h1>

      <p class="auth-intro">
        Welcome back. Sign in to write posts and leave comments.
      </p>

      <a href="/user/auth/google" class="google-button">
        Continue with Google
      </a>

      <div class="auth-divider">
        <span>or sign in with email</span>
      </div>

      <form action="/user/Signin" method="post" class="auth-form">

        <div class="form-field">
          <label for="email">
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
          >
        </div>

        <div class="form-field">
          <label for="password">
            Password
          </label>

          <input
            type="password"
            id="password"
            name="password"
            required
          >
        </div>

        <button
          type="submit"
          class="auth-submit"
        >
          Sign in
        </button>

      </form>

      <p class="auth-footer">
        New to Blogify?
        <a href="/user/signup">
          Create an account
        </a>
      </p>

    </section>

  </main>

  <%- include("partials/script.ejs") %>
</body>

</html>