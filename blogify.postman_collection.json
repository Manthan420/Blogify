{
  "info": {
    "name": "Blogify API tests",
    "description": "Status-code checks for Blogify routes. Run the folders in order with the app running on localhost:8000. Pick files for the two upload requests before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Signed out",
      "item": [
        {
          "name": "Home page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Unknown page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Shows the right message\", () => pm.expect(pm.response.text()).to.include(\"Page not found.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Post that doesn't exist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Shows the right message\", () => pm.expect(pm.response.text()).to.include(\"Blog post not found.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blog/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blog",
                "999999"
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Write page while signed out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Redirects to /user/signin\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/user/signin\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blog/add-new",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blog",
                "add-new"
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
    {
      "name": "2. Sign up",
      "item": [
        {
          "name": "Sign up with a short password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Shows the right message\", () => pm.expect(pm.response.text()).to.include(\"Password must be at least 8 characters.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "signup"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "fullName",
                  "value": "Postman Tester",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "short{{$timestamp}}@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "short12",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Sign up a new user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Redirects to /\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"testEmail\", `postman${Date.now()}@example.com`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "signup"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "fullName",
                  "value": "Postman Tester",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{testEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "postman-pass-123",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Sign up with an email that already exists",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Shows the right message\", () => pm.expect(pm.response.text()).to.include(\"An account with that email already exists.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "signup"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "fullName",
                  "value": "Postman Tester",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{testEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "postman-pass-123",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
    {
      "name": "3. Signed in",
      "item": [
        {
          "name": "Create a post (text only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Redirects to /blog/\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/blog/\"));",
                  "const m = (pm.response.headers.get(\"Location\") || \"\").match(/\\/blog\\/(\\d+)/); if (m) pm.collectionVariables.set(\"postId\", m[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blog"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Postman test post",
                  "type": "text"
                },
                {
                  "key": "body",
                  "value": "Created by the Postman collection.",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Create a post with a PDF cover",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Shows the right message\", () => pm.expect(pm.response.text()).to.include(\"Only JPG and PNG images are allowed.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blog"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Postman test post",
                  "type": "text"
                },
                {
                  "key": "body",
                  "value": "Created by the Postman collection.",
                  "type": "text"
                },
                {
                  "key": "coverImage",
                  "type": "file",
                  "src": [],
                  "description": "Pick any PDF file"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Create a post with an image over 5 MB",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Shows the right message\", () => pm.expect(pm.response.text()).to.include(\"File is too large. Maximum size is 5 MB.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blog"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Postman test post",
                  "type": "text"
                },
                {
                  "key": "body",
                  "value": "Created by the Postman collection.",
                  "type": "text"
                },
                {
                  "key": "coverImage",
                  "type": "file",
                  "src": [],
                  "description": "Pick a JPG or PNG larger than 5 MB"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Add an empty comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Redirects to error=\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"error=\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blog/comment/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blog",
                "comment",
                "{{postId}}"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "content",
                  "value": "   ",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Sign out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Redirects to /\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/signout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "signout"
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
